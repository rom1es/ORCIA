# ==============================================================================
# ORCIA — Configuration Centrale d'Environnement (.env.example)
# ==============================================================================
# Copiez ce fichier vers `.env` (`cp .env.example .env`) pour personnaliser
# les hôtes, ports, chemins et secrets locaux. Toutes les applications et scripts
# lisent automatiquement `.env` à la racine du monorepo.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Interface Web Next.js (`apps/web`) & Playwright E2E
#    (Port 3100 par défaut car le port 3000 est déjà occupé localement)
# ------------------------------------------------------------------------------
ORCIA_WEB_HOST=127.0.0.1
ORCIA_WEB_PORT=3100
PORT=3100
ORCIA_WEB_URL=http://127.0.0.1:3100
NEXT_PUBLIC_ORCIA_WEB_URL=http://127.0.0.1:3100
NEXT_PUBLIC_ORCIA_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. Backend API FastAPI (`apps/api`)
# ------------------------------------------------------------------------------
ORCIA_API_HOST=127.0.0.1
ORCIA_API_PORT=8000
ORCIA_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 3. PostgreSQL 18 + pgvector (`infra/docker/docker-compose.yml` & Alembic)
#    (Port hôte 5433 par défaut car 5432 est utilisé localement)
# ------------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=orcia
POSTGRES_PASSWORD=orcia_dev_secret
POSTGRES_DB=orcia
DATABASE_URL=postgresql+asyncpg://orcia:orcia_dev_secret@127.0.0.1:5433/orcia  # pragma: allowlist secret

# Variables de compatibilité pour `scripts/generate_db_docs.py` (tbls)
ORCIA_DB_HOST=127.0.0.1
ORCIA_DB_PORT=5433
ORCIA_DB_USER=orcia
ORCIA_DB_PASSWORD=orcia_dev_secret
ORCIA_DB_NAME=orcia

# ------------------------------------------------------------------------------
# 4. Redis 7.4 (`infra/docker/docker-compose.yml` & Dramatiq `apps/worker`)
#    (Port hôte 6380 par défaut car 6379 est utilisé localement)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6380/0
ORCIA_WORKER_STUB_BROKER=1

# ------------------------------------------------------------------------------
# 5. MinIO S3-Compatible CAS Object Store (`cas/<sha256>`)
# ------------------------------------------------------------------------------
MINIO_HOST=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=orcia_minio
MINIO_ROOT_PASSWORD=orcia_minio_secret
MINIO_BUCKET_CAS=orcia-cas
MINIO_ENDPOINT_URL=http://127.0.0.1:9000

# ------------------------------------------------------------------------------
# 6. Sécurité, Auth JWT & Coffre-fort Passthrough AES-256-GCM (`packages/orcia-core`)
# ------------------------------------------------------------------------------
ORCIA_JWT_SIGNING_SECRET=change-me-jwt-signing-secret
ORCIA_PASSTHROUGH_MASTER_KEY=change-me-aes256gcm-master-key

# ------------------------------------------------------------------------------
# 7. Chemins & Outils Dev / IA (`scripts/ai_lint.py`, Alembic, etc.)
# ------------------------------------------------------------------------------
ORCIA_MIGRATIONS_CONFIG=infra/migrations/alembic.ini
ORCIA_MIGRATIONS_DIR=infra/migrations
ORCIA_DOCKER_COMPOSE_FILE=infra/docker/docker-compose.yml
ORCIA_RUN_DIR=.orcia-run
AI_MODE=OFF
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=gemma-security
GEMINI_API_KEY=
