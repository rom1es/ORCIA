{
  "components": {
    "schemas": {
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Health check response payload for `/api/v1/health`.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "trace_id": {
            "description": "Active 32-hex W3C OpenTelemetry trace identifier.",
            "maxLength": 32,
            "minLength": 32,
            "title": "Trace Id",
            "type": "string"
          },
          "version": {
            "description": "Semantic version of the ORCIA API.",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "trace_id"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HumanProfileBadge": {
        "additionalProperties": false,
        "description": "Summary of the active user's Human Profile displayed in the Global Sidebar footer.",
        "properties": {
          "access_mode": {
            "enum": [
              "CONTRIBUTOR_ACTION_REQUIRED",
              "READ_ONLY_OBSERVER"
            ],
            "title": "Access Mode",
            "type": "string"
          },
          "archetype_key": {
            "title": "Archetype Key",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          }
        },
        "required": [
          "archetype_key",
          "display_name",
          "access_mode"
        ],
        "title": "HumanProfileBadge",
        "type": "object"
      },
      "ProblemDetails": {
        "additionalProperties": false,
        "description": "RFC 9457 Problem Details envelope returned on all ORCIA API errors.",
        "properties": {
          "detail": {
            "description": "Localized human-readable explanation specific to this occurrence.",
            "title": "Detail",
            "type": "string"
          },
          "error_code": {
            "description": "Invariant machine-readable ORCIA error code (e.g. ERR_OBSERVER_MODE_READ_ONLY).",
            "title": "Error Code",
            "type": "string"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "URI reference identifying the specific occurrence of the problem.",
            "title": "Instance"
          },
          "permission_broker_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional remediation hint from the Permission Broker (AD-6).",
            "title": "Permission Broker Hint"
          },
          "status": {
            "description": "HTTP status code generated by the origin server.",
            "maximum": 599.0,
            "minimum": 100.0,
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "description": "Short, localized human-readable summary of the problem type.",
            "title": "Title",
            "type": "string"
          },
          "trace_id": {
            "description": "32-hex W3C OpenTelemetry trace identifier correlating logs and UI.",
            "maxLength": 32,
            "minLength": 32,
            "title": "Trace Id",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "URI reference identifying the problem type.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "error_code",
          "trace_id"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "ScopeNode": {
        "additionalProperties": false,
        "description": "Node in the 4-level Hierarchical Scope Switcher (`⌘W`: GLOBAL -> BU -> TEAM -> WORKSPACE).",
        "properties": {
          "access_mode": {
            "default": "CONTRIBUTOR_ACTION_REQUIRED",
            "enum": [
              "CONTRIBUTOR_ACTION_REQUIRED",
              "READ_ONLY_OBSERVER"
            ],
            "title": "Access Mode",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "level": {
            "enum": [
              "GLOBAL",
              "BU",
              "TEAM",
              "WORKSPACE"
            ],
            "title": "Level",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          }
        },
        "required": [
          "id",
          "level",
          "name"
        ],
        "title": "ScopeNode",
        "type": "object"
      },
      "ShellModuleItem": {
        "additionalProperties": false,
        "description": "Descriptor for one of the 7 Global Sidebar Navigation modules (Direction C).",
        "properties": {
          "contributor_badge_count": {
            "default": 0,
            "minimum": 0.0,
            "title": "Contributor Badge Count",
            "type": "integer"
          },
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "has_stale_warning": {
            "default": false,
            "title": "Has Stale Warning",
            "type": "boolean"
          },
          "icon": {
            "title": "Icon",
            "type": "string"
          },
          "key": {
            "enum": [
              "cockpit",
              "inbox",
              "catalog",
              "ontology",
              "gates",
              "finops",
              "admin"
            ],
            "title": "Key",
            "type": "string"
          },
          "order": {
            "maximum": 7.0,
            "minimum": 1.0,
            "title": "Order",
            "type": "integer"
          },
          "route": {
            "title": "Route",
            "type": "string"
          }
        },
        "required": [
          "key",
          "order",
          "route",
          "icon"
        ],
        "title": "ShellModuleItem",
        "type": "object"
      },
      "ShellNavigationResponse": {
        "additionalProperties": false,
        "description": "Complete navigation and scope context for the Direction C AppShell.",
        "properties": {
          "active_scope_id": {
            "title": "Active Scope Id",
            "type": "string"
          },
          "human_profile": {
            "$ref": "#/components/schemas/HumanProfileBadge"
          },
          "modules": {
            "items": {
              "$ref": "#/components/schemas/ShellModuleItem"
            },
            "maxItems": 7,
            "minItems": 7,
            "title": "Modules",
            "type": "array"
          },
          "scopes": {
            "items": {
              "$ref": "#/components/schemas/ScopeNode"
            },
            "title": "Scopes",
            "type": "array"
          },
          "trace_id": {
            "maxLength": 32,
            "minLength": 32,
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "active_scope_id",
          "scopes",
          "modules",
          "human_profile",
          "trace_id"
        ],
        "title": "ShellNavigationResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Orchestration of Processes, Context, and Intelligent Agents — Hexagonal Modular Monolith API with RFC 9457 Problem Details.",
    "title": "ORCIA Platform API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "description": "Return platform health status and active 32-hex W3C `trace_id`.",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Check ORCIA API health and propagate W3C trace_id",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/navigation/shell": {
      "get": {
        "description": "Return the 7-module Direction C navigation shell and 4-level scope switcher state.",
        "operationId": "get_shell_navigation_api_v1_navigation_shell_get",
        "parameters": [
          {
            "description": "Optional active scope identifier to select in the 4-level scope tree.",
            "in": "query",
            "name": "scope_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional active scope identifier to select in the 4-level scope tree.",
              "title": "Scope Id"
            }
          },
          {
            "description": "When true, verifies the selected scope is not READ_ONLY_OBSERVER.",
            "in": "query",
            "name": "require_contributor",
            "required": false,
            "schema": {
              "default": false,
              "description": "When true, verifies the selected scope is not READ_ONLY_OBSERVER.",
              "title": "Require Contributor",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShellNavigationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Get Direction C 7-module Global Sidebar & Hierarchical Scope Switcher tree",
        "tags": [
          "navigation"
        ]
      }
    }
  }
}
